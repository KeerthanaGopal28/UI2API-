rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Authenticated users can ONLY access their own comparison images
    // We allow nested paths so comparisons can be grouped by comparisonId
    match /comparisons/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is blocked
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
